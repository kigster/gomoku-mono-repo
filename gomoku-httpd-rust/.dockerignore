# Build artifacts — regenerated by `cargo build` inside the builder stage.
# Excluding the host target/ (~1.4GB) is the main context-size win.
target/

# Committed binaries (incl. an 8MB macOS gomoku-httpd-rust) — must NOT ship.
# The builder produces fresh Linux binaries; the runtime stage copies those.
bin/

# VCS metadata.
.git/
.gitignore

# Local dev / env / editor cruft.
.env
.env.*
.envrc
.envrc.local
.direnv/
*.log
.DS_Store

# Docs and CI that play no part in the build.
*.md
.github/
