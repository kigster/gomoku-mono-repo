# CI config — DSN is composed from DB_USER + DB_PASSWORD + DB_NAME +
# the POSTGRESQL_PORT env var (set to 5432 by the GH Actions workflow,
# since the postgres service container maps the standard port).
DB_USER=testuser
DB_PASSWORD=testpass
DB_NAME=gomoku_test
GOMOKU_HTTPD_URL=http://localhost:10000
ENVIRONMENT=test
LOG_DIR=/tmp/logs
JWT_SECRET=ci-test-secret-key-not-for-production
