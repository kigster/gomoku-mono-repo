# vim: ft=just
#
# Gomocup tournament submission pipeline.
#
# Produces a Piskvork-compatible brain executable plus the Win32/Win64
# cross-built .exe artefacts and the submission zip under gomoku-c/bin/.
# The zip's README.txt is generated by `make gomocup-zip`; if
# `gomoku-c/GOMOCUP-README.txt` exists, its contents are appended to the
# generated README before zipping (allowed by Gomocup rules for author
# notes / project URL).
#
# Per the user's convention, this file does not define a `gomocup-all`
# joiner — `gomocup` is the only entry point.

# Build the native Gomocup brain plus both Windows cross-builds.
gomocup-build:
    @make -C gomoku-c pbrain-kig-standard gomocup-win

# Run Gomocup-specific tests: protocol e2e + brain unit tests.
gomocup-test:
    ENVIRONMENT=test make -C gomoku-c test-gomocup-e2e
    @bash gomoku-c/tests/gomocup_protocol_e2e.sh

# Package the submission zip with the README + optional appended GOMOCUP-README.
gomocup-package: gomocup-build
    @make -C gomoku-c gomocup-zip
    @if [[ -f gomoku-c/GOMOCUP-README.txt ]]; then \
        echo "Appending gomoku-c/GOMOCUP-README.txt to bin/README.txt..."; \
        printf '\n' >> gomoku-c/bin/README.txt; \
        cat gomoku-c/GOMOCUP-README.txt >> gomoku-c/bin/README.txt; \
        rm -f gomoku-c/bin/pbrain-kig-standard.zip; \
        cd gomoku-c/bin && zip -j pbrain-kig-standard.zip \
            pbrain-kig-standard-x86-64.exe \
            pbrain-kig-standard-x86-32.exe \
            README.txt; \
    fi
    @mkdir -p bin
    @cp -pv gomoku-c/bin/pbrain-* bin/
    @cp -pv gomoku-c/bin/pbrain-kig-standard.zip bin/

# Full Gomocup pipeline: build → test → package + install artifacts to ./bin
gomocup: gomocup-build gomocup-test gomocup-package
    @echo ""
    @echo "Gomocup submission ready:"
    @ls -la bin/pbrain-kig-standard.zip bin/pbrain-*.exe 2>/dev/null || true
