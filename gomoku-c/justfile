# Gomoku — C engine + gomoku-httpd daemon.
#
# Local build / test / format only. Everything monorepo-level — Docker images,
# Cloud Run deploy, AI evaluations, and the Gomocup submission pipeline — lives
# in the root justfile (see ../just/justfile.{docker,cloud-run,evals,gomocup}).

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set dotenv-load

[no-exit-message]
recipes:
    @just --choose

# Compile the C engine, gomoku-httpd daemon, and http test client
build:
    make all

# Remove compiled artifacts
clean:
    make clean

# Clean, then build from scratch
rebuild: clean build

# Copy built binaries into ./bin
install:
    make install

# Run the C engine + daemon unit + protocol e2e suite
test:
    make test

# Format all C source, tests, and shell scripts in place
format:
    find src/gomoku src/net -maxdepth 2 -name '*.c**' | xargs clang-format -i
    find tests -maxdepth 2 -name '*.c**' | xargs clang-format -i
    find bin -type f -exec bash -c 'file {} | grep -Eqvi ruby' \; -print | xargs shfmt -i 2 -w
