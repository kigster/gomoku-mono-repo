# Development .env
ENVIRONMENT="production"

# GCP
PROJECT_ID="fine-booking-486503-k7"
REGION="us-central1"
CLUSTER_NAME="gomoku-cluster"
CUSTOM_DOMAIN="app.gomoku.games"
PUBLIC_DOMAIN="app.gomoku.games"

PRODUCTION_HONEYCOMB_INGEST_API_KEY=
PRODUCTION_NONEYCOMB_CONFIG_API_KEY=
PRODUCTION_HONEYCOMB_DATASET="gomoku-api"

# Connection Pooled
# Production is being re-pointed to a fresh Neon project for the
# gomoku.us launch — fill this in BEFORE running `just deploy`.
PRODUCTION_DATABASE_URL=

PGDATABASE=gomoku
PGUSER=postgres
PGPASSWORD=
PGHOST=localhost
PGPORT=5433

# JWT Secrets
PRODUCTION_JWT_SECRET=
STAGING_JWT_SECRET=
DEVELOPMENT_JWT_SECRET=

# ─── Dev ─────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Staging ─────────────────────────────────────────────────────────────
# Repurposed from the original gomoku.games production Neon DB —
# becomes the staging DB while the new gomoku.us production project is
# being set up. Existing user accounts/games carry over to staging.
STAGING_DATABASE_URL=
# Skip the custom-domain mapping for the first staging deploy — we'll
# map either staging.gomoku.games or app.gomoku.games to the staging
# stack after the *.run.app URL is confirmed working. Set this to a
# real hostname to enable the mapping.
STAGING_CUSTOM_DOMAIN="staging.gomoku.games"

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

