# Default config for local development. Committed — no secrets.
# Override locally with .env.development.local (gitignored).
#
# DATABASE_URL is intentionally NOT set here: app/config.py composes
# `postgresql://${DB_USER}@localhost:${POSTGRESQL_PORT}/${DB_NAME}` from
# DB_USER + DB_NAME + the POSTGRESQL_PORT env var (default 5433 — the
# Homebrew postgresql@18 port, exported by the repo-root .envrc).
ENVIRONMENT=development
DB_NAME=gomoku
GOMOKU_HTTPD_URL=http://localhost:10000
JWT_SECRET=lqL3dea64YoREfhSpSJ0100WkDiHI6XrgINqpO0+pak=
CORS_ORIGINS=["*"]
