# Test config — local Postgres, gomoku_test DB. Committed — no secrets.
# Override locally with .env.test.local (gitignored).
#
# DATABASE_URL is intentionally NOT set here: app/config.py composes
# `postgresql://postgres@localhost:${POSTGRESQL_PORT}/gomoku_test`
# from DB_USER + DB_NAME + the POSTGRESQL_PORT env var (default 5433,
# exported by the root .envrc).
ENVIRONMENT=test
DB_NAME=gomoku_test
GOMOKU_HTTPD_URL=http://localhost:10000
JWT_SECRET=yC4uilljEDfdVKspJSmORIK6PpZLYLXzlT5I4meRqtY=
CORS_ORIGINS=["*"]
