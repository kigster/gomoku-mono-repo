# vim: ft=bash
PATH_add .
PATH_add bin

command -v brew >/dev/null && {
  PATH_add $(brew --prefix)/bin
}

# Single source of truth for the local Postgres port — every test runner
# (pytest, cypress, bin/db-test-setup, api/justfile) reads this. Defaults
# to 5433 because Homebrew's postgresql@18 ships listening there on this
# workstation; export it before `cd`ing in to override.
export POSTGRESQL_PORT="${POSTGRESQL_PORT:-5433}"

# Export every key in .env into the shell. Safe: everything in .env uses a
# deploy-only namespace (PRODUCTION_DATABASE_URL, PRODUCTION_JWT_SECRET,
# HONEYCOMB_*, PROJECT_ID, REGION, CLUSTER_NAME) — none of which collide with
# the runtime config Pydantic reads inside the FastAPI app.
dotenv_if_exists .env

dotenv_if_exists .env.local

